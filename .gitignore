Scenarios/**/main.json
library/**/main.json
*.parameters.json

!Scenarios/**/function/host.json
!Scenarios/**/function/package.json
!Scenarios/**/function/package-lock.json
node_modules/
local.settings.json

# Secrets and local-only parameter overrides (never commit values)
.env
.env.*
!.env.example
*.local.bicepparam
*.secrets.bicepparam
*.pfx
*.key
*.pem
*.cer
*.publishsettings
*.pubxml

