<policies>
    <inbound>
        <base />
        <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Subscription.Id)" />
        <validate-jwt header="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>{{gis-api-audience}}</audience>
            </audiences>
            <issuers>
                <issuer>https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0</issuer>
                <issuer>https://sts.windows.net/{{entra-tenant-id}}/</issuer>
            </issuers>
            <required-claims>
                <claim name="roles" match="any">
                    <value>TdpGisApi.Access</value>
                </claim>
            </required-claims>
        </validate-jwt>
        <set-header name="Accept-Encoding" exists-action="override">
            <value>identity</value>
        </set-header>
        <set-header name="Origin" exists-action="delete" />
        <set-header name="Referer" exists-action="delete" />
        <set-header name="X-Forwarded-Host" exists-action="delete" />
        <set-header name="Forwarded" exists-action="delete" />
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <set-query-parameter name="subscription-key" exists-action="delete" />
        <set-header name="Host" exists-action="override">
            <value>@(new Uri(context.Api.ServiceUrl.ToString()).Host)</value>
        </set-header>
        <set-backend-service base-url="@(context.Api.ServiceUrl.ToString().TrimEnd('/'))" />
        <rewrite-uri template="@(context.Request.OriginalUrl.Path.Substring(context.Api.Path.Length + 1))" />
        <choose>
            <when condition='@(string.IsNullOrWhiteSpace(context.Request.Headers.GetValueOrDefault("X-Access-Token", "")))'>
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":"X-Access-Token is required"}</set-body>
                </return-response>
            </when>
        </choose>
    </inbound>
    <backend>
        <forward-request timeout="120" buffer-request-body="true" buffer-response="true" />
    </backend>
    <outbound>
        <base />
        <set-body>@{
            return context.Response.Body.As<string>(preserveContent: true);
        }</set-body>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
