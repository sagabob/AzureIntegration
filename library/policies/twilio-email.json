{
  "openapi": "3.0.1",
  "info": {
    "title": "Twilio Email",
    "version": "1.0",
    "description": "Enqueue an email send request. APIM puts the body on the Service Bus queue."
  },
  "paths": {
    "/emails": {
      "post": {
        "operationId": "enqueueEmail",
        "summary": "Queue an email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "subject", "body"],
                "properties": {
                  "to": {
                    "type": "string",
                    "format": "email",
                    "minLength": 3,
                    "description": "Destination email address (shape only; APIM policy enforces a simple local@domain.tld check, not mailbox or MX)",
                    "example": "someone@example.com"
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Email subject"
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Email body"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201 only after the table row (status queued) and the Service Bus message both succeed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "id"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "queued"
                    },
                    "id": {
                      "type": "string",
                      "description": "APIM request id; table RowKey and queue body id"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing to, subject, or body; or to is not a well-formed email address"
          }
        }
      }
    }
  }
}
