{
  "openapi": "3.0.1",
  "info": {
    "title": "Twilio Email",
    "version": "1.0",
    "description": "Enqueue an email send request. APIM puts the body on the Service Bus queue."
  },
  "paths": {
    "/emails": {
      "post": {
        "operationId": "enqueueEmail",
        "summary": "Queue an email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "subject", "body"],
                "properties": {
                  "to": {
                    "type": "string",
                    "description": "Destination email address"
                  },
                  "subject": {
                    "type": "string",
                    "description": "Email subject"
                  },
                  "body": {
                    "type": "string",
                    "description": "Email body"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message accepted by Service Bus"
          }
        }
      }
    }
  }
}
