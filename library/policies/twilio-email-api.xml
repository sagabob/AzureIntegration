<policies>
    <inbound>
        <base />
        <set-header name="Accept-Encoding" exists-action="override">
            <value>identity</value>
        </set-header>
        <set-variable name="emailBody" value="@(context.Request.Body.As&lt;string&gt;(preserveContent: true))" />
        <send-request mode="new" response-variable-name="sbResponse" timeout="30" ignore-error="true">
            <set-url>https://{{twilio-service-bus-hostname}}/{{twilio-email-queue}}/messages</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-header name="BrokerProperties" exists-action="override">
                <value>{"ContentType":"application/json"}</value>
            </set-header>
            <authentication-managed-identity resource="https://servicebus.azure.net/" />
            <set-body>@((string)context.Variables["emailBody"])</set-body>
        </send-request>
        <choose>
            <when condition="@(((IResponse)context.Variables["sbResponse"]).StatusCode &gt;= 200 && ((IResponse)context.Variables["sbResponse"]).StatusCode &lt; 300)">
                <return-response>
                    <set-status code="201" reason="Created" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"status":"queued"}</set-body>
                </return-response>
            </when>
            <otherwise>
                <return-response>
                    <set-status code="@(((IResponse)context.Variables["sbResponse"]).StatusCode)" reason="Service Bus error" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>@(((IResponse)context.Variables["sbResponse"]).Body.As&lt;string&gt;())</set-body>
                </return-response>
            </otherwise>
        </choose>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
